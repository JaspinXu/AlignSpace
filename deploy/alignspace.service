[Unit]
Description=AlignSpace design brief workspace
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/alignspace
EnvironmentFile=/home/ubuntu/alignspace/.env
Environment=ALIGNSPACE_SECURE_COOKIES=true
ExecStart=/home/ubuntu/alignspace/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/alignspace/data
UMask=0077

[Install]
WantedBy=multi-user.target
