# AlignSpace environment variables (example only; never commit real secrets).
# Copy to .env for local development. `.env` and `.env.*` are git-ignored.

# --- backend ---
# SQLite database and LangGraph checkpoint files. Use isolated paths for tests.
ALIGNSPACE_DATABASE_URL=sqlite:///alignspace-accounts.db
ALIGNSPACE_CHECKPOINT_PATH=alignspace-accounts-checkpoints.db
ALIGNSPACE_ASSET_DIR=var/assets

# >=32 bytes. Development only; production must inject a real secret.
ALIGNSPACE_AUTH_SECRET=replace-with-at-least-32-bytes-of-random-secret
# "1" allows insecure cookies and is limited to loopback origins.
ALIGNSPACE_DEV=1
# Exact HTTP(S) origins, comma-separated. No wildcards.
ALIGNSPACE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALIGNSPACE_REGISTER_IP_LIMIT=10

# --- candidate preference provider ---
# mock (default, deterministic) or deepseek (real; requires a key).
ALIGNSPACE_VISION_MODE=mock
# Backend only. Never expose to the frontend, logs, snapshots or Git.
ALIGNSPACE_DEEPSEEK_API_KEY=
ALIGNSPACE_DEEPSEEK_MODEL=deepseek-flash
ALIGNSPACE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- frontend ---
# Vite dev proxy target for /v1 requests.
API_PROXY_TARGET=http://127.0.0.1:8013
# Optional local OpenPlan3D origin used by the 3D preview entry.
VITE_OPENPLAN3D_URL=http://127.0.0.1:4173
